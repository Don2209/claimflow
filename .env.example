# Where the demo and pilot forms POST their JSON. Required for the forms to work.
# Any service that accepts a JSON POST will do (Formspree, Basin, your own API).
VITE_FORM_ENDPOINT=

# The public address of the site, with no trailing slash.
# Used for canonical links, Open Graph URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=https://claimsflow.example

# Where the site sits on its host, when it is not at the root of a domain. Example: /claimflow
VITE_SITE_BASE=

# Optional analytics script URL. Leave empty to keep analytics off (the default).
# When set, a cookie notice appears and the script only loads after the visitor accepts.
VITE_ANALYTICS_SRC=
