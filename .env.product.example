# The ClaimsFlow app. Only ANTHROPIC_API_KEY is needed for AI reading.
ANTHROPIC_API_KEY=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Keep a safe copy of this. Without it, stored documents cannot be opened.
DATA_ENCRYPTION_KEY=
DATA_DIR=./data
# The app's public address, used in upload links. Render sets this by itself.
PUBLIC_URL=

# To send approved requests from the claims address. Optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# To collect attachments from a claims inbox. Optional.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
