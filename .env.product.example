# The ClaimsFlow app. Set one AI key. With a Gemini key, Gemini is used.
GEMINI_API_KEY=
# Set to true on a paid Gemini plan, which removes the "fictional documents only" warning.
GEMINI_PAID=
ANTHROPIC_API_KEY=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Keep a safe copy of this. Without it, stored documents cannot be opened. Required on Vercel.
DATA_ENCRYPTION_KEY=
# The app's public address, used in upload links. On Vercel it defaults to the production domain.
PUBLIC_URL=

# Storage. Leave these empty locally: the app then keeps a SQLite file and the documents under DATA_DIR.
DATA_DIR=./data
# On Vercel: a Turso database. The Turso integration in the Vercel Marketplace adds both.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# On Vercel: a *private* Blob store connected to the project adds this.
BLOB_READ_WRITE_TOKEN=
# On Vercel: a random string of at least 16 characters. Vercel sends it with each scheduled run.
CRON_SECRET=

# To send approved requests from the claims address. Optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# The claims inbox is set up in the app, under Settings.
# Most files the public upload pages accept in a day. Each one costs an AI call.
PUBLIC_DOCUMENTS_PER_DAY=500
