# The ClaimsFlow app. Set one AI key. With a Gemini key, Gemini is used.
GEMINI_API_KEY=
# Set to true on a paid Gemini plan, which removes the "fictional documents only" warning.
GEMINI_PAID=
ANTHROPIC_API_KEY=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Keep a safe copy of this. Without it, stored documents cannot be opened.
DATA_ENCRYPTION_KEY=
DATA_DIR=./data
# The app's public address, used in upload links. Render sets this by itself.
PUBLIC_URL=

# To send approved requests from the claims address. Optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# The claims inbox is set up in the app, under Settings.
