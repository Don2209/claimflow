{
  "name": "claimsflow-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/build-all.mjs",
    "preview": "vite preview --port 4173",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-force-exit --disable-warning=ExperimentalWarning server/test/*.test.ts",
    "product:typecheck": "tsc -p tsconfig.product.json",
    "product:dev": "vite --config vite.app.config.ts",
    "product:build": "vite build --config vite.app.config.ts",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "server:dev": "node --watch --disable-warning=ExperimentalWarning server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-ethiopic": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@google/genai": "^3.0.0",
    "@hono/node-server": "^2.1.6",
    "@hookform/resolvers": "^3.10.0",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.11.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.43.0",
    "hono": "^4.13.16",
    "imapflow": "^2.11.0",
    "lucide-react": "^1.69.0",
    "mailparser": "^3.14.2",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^6.30.6",
    "sharp": "^0.35.5",
    "word-extractor": "^1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/smtp-server": "^3.5.13",
    "@types/word-extractor": "^1.0.6",
    "@vercel/nft": "^1.11.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "hoodiecrow-imap": "^3.3.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  }
}
